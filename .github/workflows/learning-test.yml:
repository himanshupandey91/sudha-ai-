name: Sudha Autonomous Learning Test

on:
  push:
  pull_request:
  workflow_dispatch:

jobs:
  learning-test:

    runs-on: ubuntu-latest

    steps:

      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install pytest

      - name: Run measurable learning test
        run: |
          pytest -q tests/test_environment_transfer.py -s
